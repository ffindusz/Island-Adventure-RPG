{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Island Adventure",
  "version": "../package.json",
  "identifier": "io.github.ffindusz.islandadventure",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Island Adventure",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ffindusz",
    "shortDescription": "A short top-down action RPG: a castaway crosses an island to sail home.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
